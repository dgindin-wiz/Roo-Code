{
	"name": "issue-first-workflow-kit",
	"version": "0.1.0",
	"description": "Reusable Issue-first GitHub workflow assets for agent-assisted engineering work.",
	"installer": "install.sh",
	"managedBy": "issue-first-workflow-kit",
	"globalPolicy": "global/AGENTS.issue-first-policy.md",
	"skillSource": "skills/issue-first-workflow",
	"agentsBlock": {
		"begin": "<!-- BEGIN issue-first-github-workflow -->",
		"end": "<!-- END issue-first-github-workflow -->",
		"source": "files/AGENTS.workflow.md"
	},
	"payload": [
		".codex/process.md",
		".codex/templates/closeout-comment.md",
		".codex/templates/diagnosis-finalized-comment.md",
		".codex/templates/draft-pr-opened-comment.md",
		".codex/templates/implementation-container-selected-comment.md",
		".codex/templates/investigation-milestone-comment.md",
		".codex/templates/operational-issue-body.md",
		".codex/templates/validation-summary-comment.md",
		".github/pull_request_template.md",
		".github/ISSUE_TEMPLATE/bug_report.yml",
		".github/ISSUE_TEMPLATE/config.yml",
		".github/ISSUE_TEMPLATE/feature_request.yml",
		".github/ISSUE_TEMPLATE/investigation.yml",
		".github/ISSUE_TEMPLATE/marketplace.yml"
	]
}
